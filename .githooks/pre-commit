#!/usr/bin/env sh
# Barra numero CNJ real e valor do local.toml antes de entrarem no historico.
# A CI so ve depois do push, quando ja estao nos commits, e nem tem o
# local.toml. Ativar uma vez por clone:
#
#   git config core.hooksPath .githooks
#
# Pular num commit so quando o achado for falso: git commit --no-verify
set -e
raiz="$(git rev-parse --show-toplevel)"
for py in "$raiz/.venv/bin/python" "$raiz/.venv/Scripts/python.exe" python3 python py; do
    if command -v "$py" >/dev/null 2>&1; then
        exec "$py" "$raiz/scripts/checar_cnj.py" --staged
    fi
done
echo "pre-commit: Python nao encontrado, checagem de CNJ pulada" >&2
